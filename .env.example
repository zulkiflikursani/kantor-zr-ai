# ZR Engine — konfigurasi. Salin: cp .env.example .env
# Engine memakai API OpenAI-compatible: OpenAI, DeepSeek, OpenRouter, OpenLLM, dll.
# JANGAN commit file .env.

ZR_PROVIDER=openai-compatible
ZR_API_KEY=
ZR_API_BASE=https://api.deepseek.com/v1
ZR_API_MODEL=deepseek-chat

# Model terpisah per tahap (opsional; default = ZR_API_MODEL)
# ZR_PLAN_MODEL=deepseek-chat
# ZR_WORK_MODEL=deepseek-chat
# ZR_REVIEW_MODEL=deepseek-chat

# Batas & biaya
ZR_CONCURRENCY=3
ZR_TIMEOUT_MS=90000
ZR_RETRIES=2
# Harga per 1 juta token (opsional, untuk laporan biaya)
# ZR_PRICE_IN=0.27
# ZR_PRICE_OUT=1.10

# Server
# ZR_PORT=7868
